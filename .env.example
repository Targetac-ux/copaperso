# ---------------------------------------------------------------------------
# Supabase · Project Settings → API
# ---------------------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Llave publicable. Va al navegador: solo puede leer las vistas públicas.
# (En proyectos antiguos se llama "anon key" y la variable es SUPABASE_KEY.)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Llave secreta. NUNCA al navegador, nunca a git: escribe saltándose RLS.
# (En proyectos antiguos, "service_role key" en SUPABASE_SERVICE_KEY.)
SUPABASE_SECRET_KEY=sb_secret_...

# URL pública del sitio (para og:image y enlaces absolutos)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Solo para los tests e2e (opcional)
# ---------------------------------------------------------------------------
E2E_HOST_EMAIL=host@copaperso.gg
E2E_HOST_PASSWORD=
